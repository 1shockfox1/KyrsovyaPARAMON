<Window x:Class="KyrsovyaPARAMON.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Авторизация" Height="350" Width="400"
        WindowStartupLocation="CenterScreen" ResizeMode="NoResize"
        Background="#FFF0F5" FontFamily="Segoe UI">

    <Grid Margin="20">
        <StackPanel VerticalAlignment="Center">
            <TextBlock Text="Вход в систему" FontSize="24" FontWeight="Bold" 
                       Foreground="#C71585" HorizontalAlignment="Center" Margin="0,0,0,20"/>

            <TextBlock Text="Логин:" Margin="0,0,0,5"/>
            <TextBox x:Name="txtLogin" Padding="10" BorderBrush="#FFB6C1" Margin="0,0,0,15" FontSize="14"/>

            <TextBlock Text="Пароль:" Margin="0,0,0,5"/>
            <PasswordBox x:Name="txtPassword" Padding="10" BorderBrush="#FFB6C1" Margin="0,0,0,20" FontSize="14"/>

            <Button Content="Войти" Width="150" Height="40" Click="Login_Click" FontSize="16"/>

            <TextBlock x:Name="txtError" Text="Неверный логин или пароль!" 
                       Foreground="Red" FontWeight="Bold" HorizontalAlignment="Center" 
                       Margin="0,15,0,0" Visibility="Collapsed"/>
        </StackPanel>
    </Grid>
</Window>